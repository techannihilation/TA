#define TA

#include "sfxtype.h"
#include "exptype.h"

piece  base, hull, body, gem1, gem2,
		spinner1, spinner2, ring1, ring2,
		lightning1, lightning2, lightning3, lightning4, lightning5,
		vector, emits, q1, q2, q3, q4, q5,
		wake1, wake2, wake3, wake4, wake5, wake6;

static-var  Static_Var_1, bAiming, gun_1;

// Signal definitions
#define SIG_AIM				4
#define SIG_MOVE			8

lightning()
{
	While ( TRUE )
	{
		
		if (!bAiming)
		{
			spin emits around y-axis speed <10.0>;
			emit-sfx 1024 + 0 from q1;
			emit-sfx 1024 + 0 from q2;
			emit-sfx 1024 + 0 from q3;
			emit-sfx 1024 + 0 from q4;
			emit-sfx 1024 + 0 from q5;
			sleep 2500;
		}
		sleep 250;
	}	
}

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	
	start-script lightning();
	spin spinner1 around y-axis speed <15.0>;
	spin spinner2 around y-axis speed <-15.0>;
	
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from body;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

StartMoving()
{
	signal SIG_MOVE;
	set-signal-mask SIG_MOVE;
	while( TRUE )
	{
		if( Static_Var_1 == 2 or Static_Var_1 == 1 )
		{
			emit-sfx 3 from wake1;
			emit-sfx 3 from wake2;
			emit-sfx 3 from wake3;
			emit-sfx 3 from wake4;
			emit-sfx 3 from wake5;
			emit-sfx 3 from wake6;
			emit-sfx 5 from wake1;
			emit-sfx 5 from wake2;
			emit-sfx 5 from wake3;
			emit-sfx 5 from wake4;
			emit-sfx 5 from wake5;
			emit-sfx 5 from wake6;
		}
		sleep 300;
	}
}

StopMoving()
{
	signal SIG_MOVE;
	set-signal-mask SIG_MOVE;
}

setSFXoccupy(state)
{
	Static_Var_1 = state;
}

Create()
{
	hide lightning1;
	hide lightning2;
	hide lightning3;
	hide lightning4;
	hide lightning5;
	hide q1;
	hide q2;
	hide q3;
	hide q4;
	hide q5;
	gun_1 = 1;
	move vector to y-axis [150.0] now;
	start-script SmokeUnit();
}

QueryPrimary(PieceNum)
{
	if( gun_1 == 1 )
	{
		piecenum = lightning1;
	}
	if( gun_1 == 2 )
	{
		piecenum = lightning2;
	}
	if( gun_1 == 3 )
	{
		piecenum = lightning3;
	}
	if( gun_1 == 4 )
	{
		piecenum = lightning4;
	}
	if( gun_1 == 5 )
	{
		piecenum = lightning5;
	}
}

AimFromPrimary(PieceNum)
{
	PieceNum = ring1;
}

AimPrimary(heading, pitch)
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	bAiming = TRUE;
	turn vector to y-axis heading speed <600.0>;
	wait-for-turn vector around y-axis;
	move lightning1 to z-axis rand([200],[450]) now;
	move lightning2 to z-axis rand([200],[450]) now;
	move lightning3 to z-axis rand([200],[450]) now;
	move lightning4 to z-axis rand([200],[450]) now;
	move lightning5 to z-axis rand([200],[450]) now;
	move lightning1 to x-axis rand([-50],[50]) now;
	move lightning2 to x-axis rand([-50],[50]) now;
	move lightning3 to x-axis rand([-50],[50]) now;
	move lightning4 to x-axis rand([-50],[50]) now;
	move lightning5 to x-axis rand([-50],[50]) now;
	sleep 50;
	return(1);
}

FirePrimary()
{
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	emit-sfx 1024 + 0 from lightning2;
	gun_1 = 2;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning3;
	gun_1 = 3;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning4;
	gun_1 = 4;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning5;
	gun_1 = 5;
	sleep 10;
		
	emit-sfx 1024 + 0 from lightning1;
	gun_1 = 1;
	sleep 10;
	
	bAiming = FALSE;		
}

SweetSpot(PieceNum)
{
	PieceNum = base;
}

Killed(Severity, CorpseType, Random)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode gem1 type NOHEATCLOUD;
		explode hull type NOHEATCLOUD;
		explode body type NOHEATCLOUD;
		explode ring1 type NOHEATCLOUD;
		explode ring2 type NOHEATCLOUD;
		explode spinner1 type NOHEATCLOUD | FALL;
		explode spinner1 type NOHEATCLOUD | FALL;
		return (corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode gem1 type NOHEATCLOUD | FALL;
		explode hull type NOHEATCLOUD | FALL;
		explode body type NOHEATCLOUD | FALL;
		explode ring1 type NOHEATCLOUD | FALL;
		explode ring2 type NOHEATCLOUD | FALL;
		explode spinner1 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
		explode spinner1 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
		return (corpsetype);
	}
	corpsetype = 3;
	explode gem1 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode gem2 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode hull type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode body type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode ring1 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode ring2 type NOHEATCLOUD | FALL | SMOKE | FIRE | EXPLODE_ON_HIT;
	explode spinner1 type NOHEATCLOUD | FALL;
	explode spinner1 type NOHEATCLOUD | FALL;
	return (corpsetype);	
}
